# Backend: project-local PostgreSQL started by `npm run db:start`.
# Omit DATABASE_URL locally to use the repository's Unix-socket default.
# DATABASE_URL=postgresql+psycopg://health_guard@/health_guard?host=/absolute/path/to/.postgres-socket
#
# Production (Neon): use the DIRECT endpoint, not the pooled one — SQLAlchemy already pools, and
# stacking pgbouncer on top breaks psycopg prepared statements. SSL is required.
#   DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.region.aws.neon.tech/health_guard?sslmode=require
API_HOST=0.0.0.0
API_PORT=8000
# Exact browser origins allowed to call this API. In production this MUST list the deployed
# frontend or every request is blocked by CORS.
#   CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000
# Optional regex for Vercel preview deployments, whose hostnames cannot be listed in advance:
#   CORS_ORIGIN_REGEX=https://.*-your-team\.vercel\.app
# CORS_ORIGIN_REGEX=

# Prava sandbox. Keep real values only in the ignored root .env file.
PRAVA_API_KEY=pk_test_replace_me
PRAVA_SECRET_KEY=sk_test_replace_me
PRAVA_API_BASE_URL=https://sandbox.api.prava.space

# OpenAI's bounded decision layer. The model can propose and explain decisions, but deterministic
# Health Guard policy remains the final authority for product identity and spending.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Set this only after deployment, before making direct UCP calls to Shopify merchants.
# HEALTH_GUARD_UCP_PROFILE_URL=https://your-health-guard-domain.example/.well-known/ucp

# Merchant checkout: presents the one-time card at the merchant with headless Chromium.
#   playwright (default) - drive the merchant's own storefront checkout in-process
#   none                 - no checkout capability; every charge settles DECLINED
# Only a confirmed merchant order can settle APPROVED; every other outcome settles DECLINED.
# Requires one-time: playwright install chromium
MERCHANT_CHECKOUT_BACKEND=playwright
# Set false to watch the checkout happen in a real browser window (useful for a demo recording).
CHECKOUT_HEADLESS=true

# Delivery addresses are per beneficiary and live in the database (beneficiaries table), edited
# from care setup. Playwright needs the real values to fill the merchant's form, so they are not
# configured here and are never written to logs, agent traces, ledger events, or model prompts.

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
